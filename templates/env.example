# Keys the station reads from qa/secrets.env (copy this file there in a terminal, then fill in the values).
# That file is in qa/.gitignore and the safety gate refuses to read or print it. Never commit it.

# Login of your engine account (the name is the email_var in your accounts record).
# run.py only hashes it to check which account is logged in on each tablet.
QA_TEST_EMAIL=

# Optional (the secret_var in your accounts record). Only for typing the login; log in by hand instead if you can.
QA_TEST_PASSWORD=

# Optional: your personal ClickUp API token, for Hover's Today and New test pages (read-only calls).
CLICKUP_API_TOKEN=
