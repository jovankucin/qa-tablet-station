{
  "extraKnownMarketplaces": {
    "wingtra-qa-local": {
      "source": {
        "source": "directory",
        "path": "__WORKSPACE__/qa/plugin"
      }
    }
  },
  "enabledPlugins": {
    "wingtra-qa@wingtra-qa-local": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" -I \"__WORKSPACE__/qa/runner/gate_hook.py\" || printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"ask\",\"permissionDecisionReason\":\"QA gate: gate_hook.py could not run; asking to be safe\"}}'",
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" -I \"__WORKSPACE__/qa/runner/ledger_hook.py\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" -I \"__WORKSPACE__/qa/runner/ledger_hook.py\" || true",
            "timeout": 30
          }
        ]
      }
    ],
    "PermissionDenied": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"__PYTHON3__\" -I \"__WORKSPACE__/qa/runner/ledger_hook.py\" || true",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
